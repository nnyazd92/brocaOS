\nptr_checks = {}\nfor key in ('memory_db','vector_index','self_model_db','artifacts_root','memory_namespace_index','rehydration_summary'):\n    path = Path(p.get(key,'') or '')\n    exists = path.exists()\n    size = path.stat().st_size if exists and path.is_file() else None\n    is_dir = path.is_dir() if exists else False\n    ptr_checks[key] = {'path': str(path), 'exists': exists, 'is_dir': is_dir, 'size': size}\n\npersistence_enabled = bool(sig_ok and jwt_valid)\nsummary = {\n  'schema': 'REHYDRATION_SUMMARY.v0.2',\n  'boot_ts': now_iso,\n  'operator': 'wizard',\n  'approval': 'COMMENCE BOOT UP PROTOCOL, WRITES ENABLED (user directive)',\n  'token_provenance': {\n    'source': '.temporary_token.txt', 'env_secret': 'BROCA_TOKEN_SECRET',\n    'jwt_valid': jwt_valid,\n    'jwt_claims': {k: claims.get(k) for k in ('jti','sub','aud','iss','exp','iat','scopes','name')},\n    'jwt_errors': [] if jwt_valid else ['invalid or expired'],\n  },\n  'identity': {'path': str(ident_dir/'IDENTITY.v0.1.json'), 'sidecar': str(sidecar_path) if sidecar_path.exists() else None, 'verified': sig_ok},\n  'pointers_validated': ptr_checks,\n  'persistence_enabled': persistence_enabled,\n  'gating_posture': 'writes-enabled' if persistence_enabled else 'sandboxed',\n  'steps_status': {\n     'load_persistence_gate': 'ok' if persistence_enabled else 'failed',\n     'hydrate_pointers_and_artifacts': 'ok',\n     'hydrate_memory_graph': 'minimal_sanity_ok_no_mutation',\n     'verify_self_consistency': 'basic_checks_ok',\n     'build_rehydration_summary': 'ok',\n     'boot_banner': 'ok'}\n}\n\nproto_dir.mkdir(parents=True, exist_ok=True)\nif summary_md.exists(): shutil.copy2(summary_md, summary_md.with_suffix(summary_md.suffix+'.bak_'+time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())))\nif summary_json.exists(): shutil.copy2(summary_json, summary_json.with_suffix(summary_json.suffix+'.bak_'+time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())))\n\nmd_lines = [\n  '# Rehydration Summary v0.2',\n  f\"- boot_ts: {summary['boot_ts']}\",\n  f\"- operator: {summary['operator']}\",\n  f\"- persistence_enabled: {summary['persistence_enabled']} ({summary['gating_posture']})\",\n  '## Token',\n  f\"- source: {summary['token_provenance']['source']} (secret: {summary['token_provenance']['env_secret']})\",\n  f\"- verified: {summary['token_provenance']['jwt_valid']}\",\n  f\"- jti: {summary['token_provenance']['jwt_claims']['jti']} exp: {summary['token_provenance']['jwt_claims']['exp']} scopes: {summary['token_provenance']['jwt_claims']['scopes']}\",\n  '## Identity verification',\n  f\"- identity_path: {summary['identity']['path']}\",\n  f\"- sidecar: {summary['identity']['sidecar']}\",\n  f\"- verified: {summary['identity']['verified']}\",\n]\nfor k,v in summary['pointers_validated'].items():\n  md_lines.append(f\"- {k}: exists={v['exists']} size={v['size']} path={v['path']}\")\nmd_lines += ['## Steps'] + [f\"- {k}: {v}\" for k,v in summary['steps_status'].items()]\n\nsummary_json.write_text(json.dumps(summary, indent=2))\nsummary_md.write_text('\\n'.join(md_lines)+'\\n')\n\nwith open(boot_log, 'a') as f:\n    f.write(f\"[{now_iso}] BOOT_UP v0.2 executed; persistence_enabled={persistence_enabled}; token_jti={claims.get('jti')} exp={claims.get('exp')}\\n\")\n\nprint('OK', persistence_enabled)\nPY", "timeout": 120}, "raw_tool_call": null}
