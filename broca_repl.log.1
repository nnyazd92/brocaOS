{"level": "INFO", "logger": "broca.tools.registry", "message": "Tool call received: terminal", "taskName": null, "event": "tool_call_received", "tool_name": "terminal", "tool_call_id": "call_FWKpgcUElVxFETDqvKrAkJzZ", "arguments": {"command": "python - << 'PY'\nimport os,sys,json,hashlib,hmac,base64,datetime,sqlite3\nroot='.'\n# parse .env\nenv_path='.env'\nif not os.path.exists(env_path):\n    print(json.dumps({'error':'env file not found','path':env_path}))\n    sys.exit(2)\nsecret=None\nwith open(env_path,'r') as f:\n    for line in f:\n        line=line.strip()\n        if not line or line.startswith('#'): continue\n        if '=' not in line: continue\n        k,v=line.split('=',1)\n        k=k.strip(); v=v.strip().strip('\"').strip('\\'')\n        if k=='BROCA_TOKEN_SECRET':\n            secret=v\n            break\nif secret is None:\n    print(json.dumps({'error':'BROCA_TOKEN_SECRET not found in .env'}))\n    sys.exit(2)\n# load identity and signature\nident_path='docs/identity/IDENTITY.v0.1.json'\nsig_path='docs/identity/IDENTITY.v0.1.signature.json'\nif not os.path.exists(ident_path):\n    print(json.dumps({'error':'identity file not found','path':ident_path}))\n    sys.exit(2)\nif not os.path.exists(sig_path):\n    print(json.dumps({'error':'signature file not found','path':sig_path}))\n    sys.exit(2)\nwith open(ident_path,'r') as f:\n    ident=json.load(f)\nwith open(sig_path,'r') as f:\n    sigf=json.load(f)\n# canonicalize\ncanonical = json.dumps(ident, separators=(',',':'), sort_keys=True).encode('utf-8')\n# compute hmac\nkey = secret.encode('utf-8')\ndigest = hmac.new(key, canonical, hashlib.sha256).digest()\ncomputed_sig = base64.urlsafe_b64encode(digest).decode('utf-8').rstrip('=')\nfile_sig = sigf.get('signature_b64url')\nsig_match = (computed_sig==file_sig)\n# prepare summary\nsummary={'signature_match':sig_match,'identity_path':ident_path,'signature_path':sig_path,'provenance':'file:.env'}\nif not sig_match:\n    summary['computed_sig_sample']=computed_sig[:8]  # non-secret short sample\n    summary['file_sig_sample']=file_sig[:8]\n# If signature matches, perform hydration writes\nactions=[]\nfiles_hashed={}\ntry:\n    if sig_match:\n        pointers = ident.get('pointers',{})\n        # ensure logs dir\n        os.makedirs('broca/logs',exist_ok=True)\n        # touch boot log\n        ts=datetime.datetime.utcnow().isoformat()+\"Z\"\n        boot_log='broca/logs/boot_{}.log'.format(ts.replace(':','').replace('.',''))\n        with open(boot_log,'w') as f:\n            f.write('Boot and hydration started at '+ts+'\\n')\n            f.write('Token provenance: file:.env\\n')\n        actions.append({'wrote':boot_log})\n        # hydrate memory_db\n        memory_db = pointers.get('memory_db') or 'memories.db'\n        if memory_db:\n            d=os.path.dirname(memory_db)\n            if d: os.makedirs(d, exist_ok=True)\n            conn=sqlite3.connect(memory_db)\n            conn.execute('CREATE TABLE IF NOT EXISTS metadata(k TEXT PRIMARY KEY, v TEXT)')\n            conn.execute('INSERT OR REPLACE INTO metadata(k,v) VALUES(?,?)',('hydrated_at',ts))\n            conn.commit(); conn.close()\n            actions.append({'ensured_sqlite':memory_db})\n            with open(memory_db,'rb') as bf:\n                files_hashed[memory_db]=hashlib.sha256(bf.read()).hexdigest()\n        # hydrate vector_index: touch file\n        vector_index = pointers.get('vector_index') or 'memories.faiss'\n        if vector_index:\n            d=os.path.dirname(vector_index)\n            if d: os.makedirs(d, exist_ok=True)\n            open(vector_index,'ab').close()\n            actions.append({'touched':vector_index})\n            with open(vector_index,'rb') as bf:\n                files_hashed[vector_index]=hashlib.sha256(bf.read()).hexdigest()\n        # hydrate self_model_db\n        self_model_db = pointers.get('self_model_db') or 'self_model.db'\n        if self_model_db:\n            d=os.path.dirname(self_model_db)\n            if d: os.makedirs(d, exist_ok=True)\n            conn=sqlite3.connect(self_model_db)\n            conn.execute('CREATE TABLE IF NOT EXISTS self_model(k TEXT, v TEXT)')\n            conn.commit(); conn.close()\n            actions.append({'ensured_sqlite':self_model_db})\n            with open(self_model_db,'rb') as bf:\n                files_hashed[self_model_db]=hashlib.sha256(bf.read()).hexdigest()\n        # update REHYDRATION_SUMMARY\n        rs_path='broca/logs/REHYDRATION_SUMMARY.v0.2.json'\n        try:\n            with open(rs_path,'r') as f:\n                rs=json.load(f)\n        except Exception:\n            rs={}\n        rs.update({'hydration':{'timestamp':ts,'actions':actions,'files_hashed':files_hashed,'pointers_resolved':pointers}})\n        with open(rs_path,'w') as f:\n            json.dump(rs,f,indent=2)\n        # write sha of summary\n        import subprocess\n        sha = hashlib.sha256(open(rs_path,'rb').read()).hexdigest()\n        with open(rs_path+'.sha256','w') as f:\n            f.write(sha)\n        actions.append({'updated':rs_path})\n    else:\n        actions.append({'note':'signature did not verify; no hydration performed'})\nexcept Exception as e:\n    summary['error']=str(e)\n    print(json.dumps(summary))\n    sys.exit(3)\nsummary['actions']=actions\nsummary['files_hashed']=files_hashed\nprint(json.dumps(summary))\nPY", "working_dir": "/home/wizard/Documents/Code/BrocaOS", "timeout": 120}, "raw_tool_call": null}
