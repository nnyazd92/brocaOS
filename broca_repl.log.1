{"level": "INFO", "logger": "broca.tools.registry", "message": "Tool call received: terminal", "taskName": null, "event": "tool_call_received", "tool_name": "terminal", "tool_call_id": "call_vdOSE8L7wHed1l5kyWKotrvA", "arguments": {"command": "python - << 'PY'\nimport json, time, hmac, hashlib, base64\nfrom pathlib import Path\n\n# Verify again\nsecret=None\nfor line in Path('.env').read_text().splitlines():\n    if line.strip().startswith('BROCA_TOKEN_SECRET='):\n        secret = line.split('=',1)[1].strip(); break\nenc=lambda b: base64.urlsafe_b64encode(b).decode().rstrip('=')\n\nclaims={}\nwith open('.temporary_token.txt') as f:\n    token=json.load(f)['token']\n\nb64h,b64p,b64s = token.split('.')\naddpad=lambda s: s + '=' * (-len(s) % 4)\nclaims = json.loads(base64.urlsafe_b64decode(addpad(b64p)))\nsig_calc = enc(hmac.new(secret.encode(), (b64h+'.'+b64p).encode(), hashlib.sha256).digest())\njwt_valid = (sig_calc==b64s) and (int(time.time()) < int(claims['exp']))\n\nident = json.loads(Path('docs/identity/IDENTITY.v0.1.json').read_text())\nsidecar = json.loads(Path('docs/identity/IDENTITY.v0.1.signature.json').read_text())\ncanon = lambda obj: json.dumps(obj, separators=(',',':'), sort_keys=True).encode()\nident_no_sig = {k:v for k,v in ident.items() if k!='signature_meta'}\ncalc_id = enc(hmac.new(secret.encode(), canon(ident_no_sig), hashlib.sha256).digest())\nsig_ok = ident.get('signature_meta',{}).get('signature_b64url')==calc_id and sidecar.get('signature_b64url')==calc_id\nprint('jwt_valid', jwt_valid, 'sig_ok', sig_ok)\nPY"}, "raw_tool_call": null}
