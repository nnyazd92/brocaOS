{"level": "INFO", "logger": "broca.tools.registry", "message": "Tool call received: terminal", "taskName": null, "event": "tool_call_received", "tool_name": "terminal", "tool_call_id": "call_GrnNgIp554NcEisaL6LWWuA2", "arguments": {"command": "python - << 'PY'\nimport json, time, hmac, hashlib, base64\nfrom pathlib import Path\n\n# Re-run persistence gate\n# Load new token\nclaims={}\nwith open('.temporary_token.txt') as f:\n    token=json.load(f)['token']\n\nb64h,b64p,b64s = token.split('.')\naddpad = lambda s: s + '=' * (-len(s) % 4)\nclaims = json.loads(base64.urlsafe_b64decode(addpad(b64p)))\n\n# Load secret\nsecret=None\nfor line in Path('.env').read_text().splitlines():\n    if line.strip().startswith('BROCA_TOKEN_SECRET='):\n        secret = line.split('=',1)[1].strip(); break\nenc=lambda b: base64.urlsafe_b64encode(b).decode().rstrip('=')\n\nsig_calc = enc(hmac.new(secret.encode(), (b64h+'.'+b64p).encode(), hashlib.sha256).digest())\njwt_valid = (sig_calc==b64s) and (int(time.time()) < int(claims['exp']))\n\n# Verify identity\nident = json.loads(Path('docs/identity/IDENTITY.v0.1.json').read_text())\nsidecar = json.loads(Path('docs/identity/IDENTITY.v0.1.signature.json').read_text())\ncanon = lambda obj: json.dumps(obj, separators=(',',':'), sort_keys=True).encode()\nident_no_sig = {k:v for k,v in ident.items() if k!='signature_meta'}\ncalc_id = enc(hmac.new(secret.encode(), canon(ident_no_sig), hashlib.sha256).digest())\nsig_ok = ident.get('signature_meta',{}).get('signature_b64url')==calc_id and sidecar.get('signature_b64url')==calc_id\n\npersistence_enabled = bool(jwt_valid and sig_ok)\n\n# Update summary\nproto_dir = Path('docs/protocols')\nsummary_json = proto_dir/'REHYDRATION_SUMMARY.json'\nsummary_md = proto_dir/'REHYDRATION_SUMMARY.v0.2.md'\ns = json.loads(summary_json.read_text())\ns['boot_ts'] = time.strftime('%Y-%m-%dT%H:%M:%S%z')\ns['token_provenance']['jwt_valid'] = jwt_valid\ns['token_provenance']['jwt_claims'] = {k: claims.get(k) for k in ('jti','sub','aud','iss','exp','iat','scopes','name')}\ns['token_provenance']['jwt_errors'] = [] if jwt_valid else ['invalid or expired']\ns['identity']['verified'] = sig_ok\ns['persistence_enabled'] = persistence_enabled\ns['gating_posture'] = 'writes-enabled' if persistence_enabled else 'sandboxed'\ns['steps_status']['load_persistence_gate'] = 'ok' if persistence_enabled else 'failed'\n\n# re-render md\nlines = []\nlines.append('# Rehydration Summary v0.2')\nlines.append(f\"- boot_ts: {s['boot_ts']}\")\nlines.append(f\"- operator: {s['operator']}\")\nlines.append(f\"- persistence_enabled: {s['persistence_enabled']} ({s['gating_posture']})\")\nlines.append('## Token')\nlines.append(f\"- source: {s['token_provenance']['source']} (secret: {s['token_provenance']['env_secret']})\")\nlines.append(f\"- verified: {s['token_provenance']['jwt_valid']}\")\nlines.append(f\"- jti: {s['token_provenance']['jwt_claims'].get('jti')} exp: {s['token_provenance']['jwt_claims'].get('exp')} scopes: {s['token_provenance']['jwt_claims'].get('scopes')}\")\nlines.append('## Identity verification')\nlines.append(f\"- identity_path: {s['identity']['path']}\")\nlines.append(f\"- sidecar: {s['identity']['sidecar']}\")\nlines.append(f\"- verified: {s['identity']['verified']}\")\nfor k,v in s['pointers_validated'].items():\n    lines.append(f\"- {k}: exists={v['exists']} size={v['size']} path={v['path']}\")\nlines.append('## Steps')\nfor k,v in s['steps_status'].items():\n    lines.append(f\"- {k}: {v}\")\n\nsummary_json.write_text(json.dumps(s, indent=2))\nsummary_md.write_text('\\n'.join(lines)+'\\n')\n\n# Append boot log\nwith open('boot.log','a') as f:\n    f.write(f\"[{time.strftime('%Y-%m-%dT%H:%M:%S%z')}] Persistence gate retry; persistence_enabled={persistence_enabled}; token_jti={s['token_provenance']['jwt_claims'].get('jti')}\\n\")\n\nprint('persistence_enabled=', persistence_enabled)\nPY", "timeout": 120}, "raw_tool_call": null}
