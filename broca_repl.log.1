{"level": "INFO", "logger": "broca.tools.registry", "message": "Tool call received: terminal", "taskName": null, "event": "tool_call_received", "tool_name": "terminal", "tool_call_id": "call_FZDYmjnbw81oWXkqgFqpKSQD", "arguments": {"command": "python - << 'PY'\nimport json, os, time, hmac, hashlib, base64, sys\nfrom pathlib import Path\n\nroot = Path('.')\n# Load token JSON\ntry:\n    data = json.loads(Path('.temporary_token.txt').read_text())\n    token = data.get('token')\nexcept Exception as e:\n    print(json.dumps({\"ok\": False, \"error\": f\"failed_read_token: {e}\"}))\n    sys.exit(0)\n\n# Load secret from .env\nsecret = None\ntry:\n    for line in Path('.env').read_text().splitlines():\n        line=line.strip()\n        if not line or line.startswith('#'):\n            continue\n        if line.split('=')[0].strip()== 'BROCA_TOKEN_SECRET':\n            secret = line.split('=',1)[1].strip()\n            break\nexcept Exception as e:\n    pass\n\nres = {\"ok\": True, \"steps\": []}\nif not token:\n    print(json.dumps({\"ok\": False, \"error\": \"no_token_in_file\"}))\n    sys.exit(0)\n\nparts = token.split('.')\nif len(parts) != 3:\n    print(json.dumps({\"ok\": False, \"error\": \"malformed_jwt\"}))\n    sys.exit(0)\n\nb64h, b64p, b64s = parts\n\ndef b64url_decode(s):\n    s += '=' * (-len(s) % 4)\n    return base64.urlsafe_b64decode(s.encode())\n\ndef b64url_encode(b):\n    return base64.urlsafe_b64encode(b).decode().rstrip('=')\n\ntry:\n    header = json.loads(b64url_decode(b64h))\n    payload = json.loads(b64url_decode(b64p))\nexcept Exception as e:\n    print(json.dumps({\"ok\": False, \"error\": f\"decode_error: {e}\"}))\n    sys.exit(0)\n\nnow = int(time.time())\nerrs = []\nvalid_sig = None\nif secret:\n    msg = (b64h + '.' + b64p).encode()\n    sig = hmac.new(secret.encode(), msg, hashlib.sha256).digest()\n    calc = b64url_encode(sig)\n    valid_sig = (calc == b64s)\nelse:\n    errs.append('missing_secret')\n\nfor claim, check in {\n    'aud': lambda v: v == 'broca-os',\n    'iss': lambda v: v in ('broca-token-v1','broca-os'),\n}.items():\n    if claim in payload and not check(payload[claim]):\n        errs.append(f'bad_{claim}')\n\nif 'exp' in payload and now >= int(payload['exp']):\n    errs.append('token_expired')\nif 'nbf' in payload and now < int(payload['nbf']):\n    errs.append('token_not_yet_valid')\n\nok = (valid_sig is True) and (not errs)\nprint(json.dumps({\n    'ok': ok,\n    'valid_sig': valid_sig,\n    'errs': errs,\n    'header': header,\n    'claims': payload,\n    'now': now,\n    'secret_present': bool(secret),\n}))\nPY"}, "raw_tool_call": null}
