OINTER='/home/wizard/broca/broca.session.pointer'\\\\nARTINDEX='/home/wizard/broca/broca.artifacts'\\\\n\\\\n\\\\ndef now_ts():\\\\n    return datetime.utcnow().strftime('%Y-%m-%dT%H:%M:%SZ')\\\\n\\\\n\\\\ndef load_json(path):\\\\n    try:\\\\n        with open(path,'r') as f:\\\\n            return json.load(f)\\\\n    except Exception:\\\\n        return None\\\\n\\\\n\\\\ndef canonicalize_text_to_statements(text, source='system_prompt'):\\\\n    # Very simple canonicalization: split on sentences by periods/newlines.\\\\n    parts = [p.strip() for p in text.replace('\\\\\\\\r','\\\\\\\\n').split('\\\\\\\\n') if p.strip()]\\\\n    statements = []\\\\n    sid = 1\\\\n    for p in parts:\\\\n        for s in [ss.strip() for ss in p.split('.') if ss.strip()]:\\\\n            statements.append({\\\\n                'id': f's{sid}',\\\\n                'text': s + ('.' if not s.endswith('.') else ''),\\\\n                'type': 'inferred',\\\\n                'tags': [],\\\\n                'source': source,\\\\n                'last_updated': now_ts(),\\\\n                'importance': None,\\\\n                'centrality': None,\\\\n                'contradiction_flags': []\\\\n            })\\\\n            sid += 1\\\\n    return statements\\\\n\\\\n\\\\ndef pseudo_embedding_hash(text):\\\\n    # placeholder: deterministic hash used as a cheap \\\\\\\"embedding\\\\\\\" proxy\\\\n    h = hashlib.sha256(text.encode()).digest()\\\\n    return base64.urlsafe_b64encode(h).decode().rstrip('=')\\\\n\\\\n\\\\ndef compute_centrality(statements):\\\\n    # simple similarity-based centrality: Jaccard over token sets\\\\n    tokens = [set(s['text'].lower().split()) for s in statements]\\\\n    n = len(statements)\\\\n    scores = [0.0]*n\\\\n    for i in range(n):\\\\n        for j in range(n):\\\\n            if i==j: continue\\\\n            a = tokens[i]\\\\n            b = tokens[j]\\\\n            if not a or not b: continue\\\\n            inter = len(a & b)\\\\n            union = len(a | b)\\\\n            sim = inter/union if union>0 else 0.0\\\\n            scores[i] += sim\\\\n    # normalize\\\\n    maxs = max(scores) if scores else 1.0\\\\n    if maxs==0: maxs=1.0\\\\n    for i in range(n):\\\\n        statements[i]['centrality'] = scores[i]/maxs\\\\n    return statements\\\\n\\\\n\\\\ndef score_importance(statements, weights=None):\\\\n    # weights: {'centrality':0.6, 'recency':0.2, 'tag_core':0.2}\\\\n    if weights is None:\\\\n        weights = {'centrality':0.7, 'recency':0.1, 'tag_core':0.2}\\\\n    now = time.time()\\\\n    for s in statements:\\\\n        centrality = s.get('centrality') or 0.0\\\\n        # recency: inverse seconds since update, clipped\\\\n        try:\\\\n            t = datetime.strptime(s.get('last_updated'), '%Y-%m-%dT%H:%M:%SZ').timestamp()\\\\n            recency = 1.0 / (1.0 + (now - t)/86400.0)\\\\n        except Exception:\\\\n            recency = 0.0\\\\n        tag_core = 1.0 if 'core' in s.get('tags',[]) else 0.0\\\\n        s['importance'] = weights['centrality']*centrality + weights['recency']*recency + weights['tag_core']*tag_core\\\\n    return statements\\\\n\\\\n\\\\ndef hmac_sign_obj(obj, secret_env='BROCA_TOKEN_SECRET'):\\\\n    secret = os.environ.get(secret_env)\\\\n    if not secret:\\\\n        return None\\\\n    serialized = json.dumps(obj, separators=(',',':'), sort_keys=True)\\\\n    sig = hmac.new(secret.encode(), serialized.encode(), hashlib.sha256).digest()\\\\n    return base64.urlsafe_b64encode(sig).decode().rstrip('=')\\\\n\\\\n\\\\ndef build_snapshot(schema, statements, artifacts, provenance):\\\\n    snapshot = {\\\\n        'meta': {\\\\n            'schema_id': schema.get('title','broca.schema'),\\\\n            'version': schema.get('version',1) if isinstance(schema, dict) else 1,\\\\n            'created_by': provenance.get('created_by','unknown'),\\\\n            'timestamp': now_ts()\\\\n        },\\\\n        'identity': {\\\\n            'id': 'broca',\\\\n            'name': 'BrocaOS',\\\\n            'canonical_description': 'Dynamic generated self-model snapshot for BrocaOS.'\\\\n        },\\\\n        'invariants': schema.get('invariants',[]),\\\\n        'statements': statements,\\\\n        'metrics': {\\\\n            'consistency_score': 1.0,\\\\n            'contradiction_count': 0,\\\\n            'last_checked': now_ts()\\\\n        },\\\\n        'artifacts': [{'path':p,'type':'unknown','sha256':None} for p in (artifacts or [])],\\\\n        'generation_config': schema.get('generation_config',{}),\\\\n        'history': [],\\\\n        'provenance': provenance\\\\n    }\\\\n    # sign snapshot if possible\\\\n    h = hmac_sign_obj(snapshot)\\\\n    if h:\\\\n        snapshot.setdefault('provenance',{})['hmac'] = h\\\\n    return snapshot\\\\n\\\\n\\\\ndef main():\\\\n    p = argparse.ArgumentParser()\\\\n    p.add_argument('--schema', default=DEFAULT_SCHEMA)\\\\n    p.add_argument('--output-dir', default=DEFAULT_OUTPUT_DIR)\\\\n    p.add_argument('--commit', action='store_true', help='If set, update broca.artifacts and broca.session.pointer')\\\\n    p.add_argument('--system-prompt', default=None, help='Path to system prompt text to incorporate')\\\\n    args = p.parse_args()\\\\n\\\\n    schema = load_json(args.schema) or {}\\\\n    # determine system prompt path\\\\n    spath = args.system_prompt or schema.get('generation_config',{}).get('system_prompt_path')\\\\n\\\\n    artifacts = []\\\\n    # read pointer and artifact index if present\\\\n    pointer = load_json(POINTER)\\\\n    aindex = load_json(ARTINDEX)\\\\n    if pointer:\\\\n        # gather files referenced\\\\n        cur = pointer.get('current_session_summary')\\\\n        if cur: artifacts.append(cur)\\\\n    if aindex:\\\\n        for a in aindex.get('artifacts',[]):\\\\n            path = a.get('path')\\\\n            if path and path not in artifacts:\\\\n                artifacts.append(path)\\\\n\\\\n    # also include system prompt file if available\\\\n    texts = []\\\\n    if spath and os.path.exists(spath):\\\\n        try:\\\\n            texts.append(open(spath,'r').read())\\\\n            artifacts.append(spath)\\\\n        except Exception:\\\\n            pass\\\\n\\\\n    # read artifact files' contents (first pass)\\\\n    for pth in list(artifacts):\\\\n        if os.path.exists(pth):\\\\n            try:\\\\n                texts.append(open(pth,'r').read())\\\\n            except Exception:\\\\n                pass\\\\n\\\\n    combined_text = '\\\\\\\\n\\\\\\\\n'.join(texts) if texts else ''\\\\n    if not combined_text:\\\\n        # fallback: use a short default description\\\\n        combined_text = 'BrocaOS dynamic self-model generation. No artifacts available.'\\\\n\\\\n    statements = canonicalize_text_to_statements(combined_text)\\\\n    # compute pseudo-embeddings and centrality/importance\\\\n    for s in statements:\\\\n        s['embedding_hash'] = pseudo_embedding_hash(s['text'])\\\\n    statements = compute_centrality(statements)\\\\n    statements = score_importance(statements, weights=schema.get('generation_config',{}).get('importance_weights'))\\\\n\\\\n    provenance = {\\\\n        'created_by': os.environ.get('USER','unknown'),\\\\n        'jti': None,\\\\n        'token_file': '/home/wizard/Documents/Code/BrocaOS/.temporary_token.txt'\\\\n    }\\\\n    # try to read token jti\\\\n    try:\\\\n        import json as _j\\\\n        tok = _j.load(open(provenance['token_file']))\\\\n        if isinstance(tok, dict) and 'payload' in tok:\\\\n            provenance['jti'] = tok['payload'].get('jti')\\\\n    except Exception:\\\\n        pass\\\\n\\\\n    snapshot = build_snapshot(schema, statements, artifacts, provenance)\\\\n\\\\n    # ensure output dir\\\\n    os.makedirs(args.output_dir, exist_ok=True)\\\\n    fname = os.path.join(args.output_dir, 'self-' + datetime.utcnow().strftime('%Y%m%dT%H%M%SZ') + '.json')\\\\n    # write to file (always write snapsho