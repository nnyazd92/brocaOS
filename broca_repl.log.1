{"level": "INFO", "logger": "broca.tools.registry", "message": "Tool execution completed: terminal", "taskName": null, "event": "tool_call_result", "tool_name": "terminal", "tool_call_id": "call_8xKCl5ysVVQFTRY3J63bCMru", "result": {"success": true, "returncode": 0, "stdout": "total 232\ndrwxr-xr-x.  4 wizard wizard  4096 Dec 18 15:32 .\ndrwxr-xr-x. 19 wizard wizard  4096 Dec 20 17:16 ..\ndrwxr-xr-x.  3 wizard wizard  4096 Dec 15 14:34 conflict\n-rw-r--r--.  1 wizard wizard  8251 Dec 14 06:22 deduplicate_existing.py\n-rw-r--r--.  1 wizard wizard  7360 Dec 11 09:32 embeddings.py\n-rw-r--r--.  1 wizard wizard  7800 Dec 15 15:52 __init__.py\n-rw-r--r--.  1 wizard wizard 93772 Dec 15 15:56 manager.py\n-rw-r--r--.  1 wizard wizard  7236 Dec 18 15:32 namespace_index.py\ndrwxr-xr-x.  2 wizard wizard  4096 Dec 18 15:34 __pycache__\n-rw-r--r--.  1 wizard wizard 10840 Dec 14 08:52 relationships.py\n-rw-r--r--.  1 wizard wizard 40843 Dec 18 15:32 storage.py\n-rw-r--r--.  1 wizard wizard 10604 Dec 15 14:40 temporal_consistency.py\n-rw-r--r--.  1 wizard wizard 11372 Dec 15 14:40 temporal.py\n-rw-r--r--.  1 wizard wizard  8617 Dec 14 08:23 vector_index.py\n\"\"\"\nMemory record schema and data models.\n\nDefines the MemoryRecord structure for storing and retrieving memories.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom datetime import datetime, timezone\nfrom typing import List, Optional, Dict, Any, Literal\nfrom enum import Enum\nfrom pydantic import BaseModel, Field, field_validator\n\n\nclass SourceType(str, Enum):\n    \"\"\"\n    Types of sources for memory records.\n    \n    Tracks where information came from:\n    - WEB_SEARCH: Information from web searches\n    - USER: Information from user input/conversation\n    - SYSTEM_FILE: Information from reading system files\n    - TERMINAL_OUTPUT: Information from terminal commands\n    - MEMORY_RETRIEVAL: Information retrieved from existing memories\n    - UNKNOWN: Unknown source (for migration/backward compatibility)\n    \"\"\"\n    WEB_SEARCH = \"web_search\"\n    USER = \"user\"\n    SYSTEM_FILE = \"system_file\"\n    TERMINAL_OUTPUT = \"terminal_output\"\n    MEMORY_RETRIEVAL = \"memory_retrieval\"\n    UNKNOWN = \"unknown\"\n\n\nclass SourceMetadata(BaseModel):\n    \"\"\"\n    Metadata about the source of a memory.\n    \n    Attributes:\n        source_type: The type of source (web search, user, system file, etc.)\n        metadata: Optional additional context (URLs, file paths, queries, etc.)\n    \"\"\"\n    source_type: SourceType = Field(..., description=\"The type of source\")\n    metadata: Optional[Dict[str, Any]] = Field(\n        default=None,\n        description=\"Additional context (URLs, file paths, queries, etc.)\"\n    )\n\n\nclass MemoryRecord(BaseModel):\n    \"\"\"\n    Memory record schema for storing facts, insights, and information.\n    \n    Attributes:\n        id: Unique identifier (auto-generated by storage)\n        namespace: Hierarchical namespace (e.g., \"math.sage.api\")\n        tags: List of tags for categorization\n        text: The actual memory content/fact\n        importance: Importance score from 0.0 to 1.0\n        created_at: Timestamp when memory was created\n        last_used_at: Timestamp when memory was last retrieved\n        embedding: Optional embedding vector (stored separately in FAISS)\n        valid_from: Optional timestamp when this fact became true\n        valid_until: Optional timestamp when this fact stopped being true\n        temporal_scope: Optional temporal classification (\"past\", \"present\", \"future\", \"timeless\")\n        source: Optional source metadata tracking where the memory came from\n    \"\"\"\n    \n    id: Optional[int] = None\n    namespace: str = Field(..., min_length=1, description=\"Hierarchical namespace for the memory\")\n    tags: List[str] = Field(default_factory=list, description=\"Tags for categorization\")\n    text: str = Field(..., min_length=1, description=\"The memory content/fact\")\n    importance: float = Field(..., ge=0.0, le=1.0, description=\"Importance score from 0.0 to 1.0\")\n    created_at: datetime = Field(default_factory=lambda: datetime.now(timezone.utc))\n    last_used_at: datetime = Field(default_factory=lambda: datetime.now(timezone.utc))\n    embedding: Optional[List[float]] = Field(default=None, description=\"Embedding vector (stored in FAISS)\")\n    valid_from: Optional[datetime] = Field(default=None, description=\"Timestamp when this fact became true\")\n    valid_until: Optional[datetime] = Field(default=None, description=\"Timestamp when this fact stopped being true\")\n    temporal_scope: Optional[Literal[\"past\", \"present\", \"future\", \"timeless\"]] = Field(\n        default=None, description=\"Temporal classification\"\n    )\n    source: Optional[SourceMetadata] = Field(\n        default=None,\n        description=\"Source metadata tracking where the memory came from\"\n    )\n    \n    @field_validator('namespace')\n    @classmethod\n    def validate_namespace(cls, v: str) -> str:\n        \"\"\"Validate namespace is not empty.\"\"\"\n        if not v or not v.strip():\n            raise ValueError(\"Namespace cannot be empty\")\n        return v.strip()\n    \n    @field_validator('text')\n    @classmethod\n    def validate_text(cls, v: str) -> str:\n        \"\"\"Validate text is not empty.\"\"\"\n        if not v or not v.strip():\n            raise ValueError(\"Text cannot be empty\")\n        return v.strip()\n    \n    @field_validator('tags')\n    @classmethod\n    def validate_tags(cls, v: List[str]) -> List[str]:\n        \"\"\"Validate and clean tags.\"\"\"\n        # Remove empty tags and strip whitespace\n        cleaned = [tag.strip() for tag in v if tag and tag.strip()]\n        return cleaned\n    \n    @field_validator('importance')\n    @classmethod\n    def validate_importance(cls, v: float) -> float:\n        \"\"\"Validate importance is in range [0.0, 1.0].\"\"\"\n        if not 0.0 <= v <= 1.0:\n            raise ValueError(f\"Importance must be between 0.0 and 1.0, got {v}\")\n        return v\n    \n    def update_last_used(self) -> None:\n        \"\"\"Update the last_used_at timestamp to now.\"\"\"\n        self.last_used_at = datetime.now(timezone.utc)\n\n\nclass RelationType(str, Enum):\n    \"\"\"\n    Types of relationships between memories.\n    \n    Logical relationships:\n    - SUPPORTS: Evidence for another memory\n    - CONTRADICTS: Conflicts with another memory\n    - SUPERSEDES: Replaces/updates another memory\n    \n    Structural relationships:\n    - ELABORATES: Adds detail to another memory\n    - SUMMARIZES: Condenses another memory\n    - REFERENCES: General reference/citation\n    \n    Causal relationships:\n    - CAUSES: Leads to another memory/event\n    - CAUSED_BY: Resulted from another memory/event\n    \n    Temporal relationships:\n    - PRECEDES: Happened before\n    - FOLLOWS: Happened after\n    \n    Semantic relationships:\n    - SIMILAR_TO: Semantically similar (auto-detected)\n    - RELATED_TO: General relation\n    \"\"\"\n    # Logical relationships\n    SUPPORTS = \"supports\"\n    CONTRADICTS = \"contradicts\"\n    SUPERSEDES = \"supersedes\"\n    \n    # Structural relationships\n    ELABORATES = \"elaborates\"\n    SUMMARIZES = \"summarizes\"\n    REFERENCES = \"references\"\n    \n    # Causal relationships\n    CAUSES = \"causes\"\n    CAUSED_BY = \"caused_by\"\n    \n    # Temporal relationships\n    PRECEDES = \"precedes\"\n    FOLLOWS = \"follows\"\n    \n    # Semantic relationships\n    SIMILAR_TO = \"similar_to\"\n    RELATED_TO = \"related_to\"\n\n\nclass RelationshipRecord(BaseModel):\n    \"\"\"\n    Represents a relationship between two memories.\n    \n    Attributes:\n        source_id: ID of the source memory\n        target_id: ID of the target memory\n        relation_type: Type of relationship\n        strength: Relationship strength from 0.0 to 1.0\n        bidirectional: Whether relationship goes both ways\n        metadata: Optional additional context (JSON-serializable dict)\n        id: Unique identifier (auto-generated by storage)\n        created_at: Timestamp when relationship was created\n    \"\"\"\n    \n    source_id: int = Field(..., description=\"ID of the source memory\")\n    target_id: int = Field(..., description=\"ID of the target memory\")\n    relation_type: RelationType = Field(..., description=\"Type of relationship\")\n    strength: float = Field(default=1.0, ge=0.0, le=1.0, description=\"Relationship strength from 0.0 to 1.0\")\n    bidirectional: bool = Field(default=False, description=\"Whether relationship goes both ways\")\n    metadata: Optional[Dict[str, Any]] = Field(default=None, description=\"Additional context\")\n    id: Optional[int] = Field(default=None, description=\"Unique identifier (auto-generated)\")\n    created_at: Optional[datetime] = Field(default=None, description=\"Timestamp when relationship was created\")\n    \n    @field_validator('strength')\n    @classmethod\n    def validate_strength(cls, v: float) -> float:\ntotal 232\ndrwxr-xr-x.  4 wizard wizard  4096 Dec 18 15:32 .\ndrwxr-xr-x. 19 wizard wizard  4096 Dec 20 17:16 ..\ndrwxr-xr-x.  3 wizard wizard  4096 Dec 15 14:34 conflict\n-rw-r--r--.  1 wizard wizard  8251 Dec 14 06:22 deduplicate_existing.py\n-rw-r--r--.  1 wizard wizard  7360 Dec 11 09:32 embeddings.py\n-rw-r--r--.  1 wizard wizard  7800 Dec 15 15:52 __init__.py\n-rw-r--r--.  1 wizard wizard 93772 Dec 15 15:56 manager.py\n-rw-r--r--.  1 wizard wizard  7236 Dec 18 15:32 namespace_index.py\ndrwxr-xr-x.  2 wizard wizard  4096 Dec 18 15:34 __pycache__\n-rw-r--r--.  1 wizard wizard 10840 Dec 14 08:52 relationships.py\n-rw-r--r--.  1 wizard wizard 40843 Dec 18 15:32 storage.py\n-rw-r--r--.  1 wizard wizard 10604 Dec 15 14:40 temporal_consistency.py\n-rw-r--r--.  1 wizard wizard 11372 Dec 15 14:40 temporal.py\n-rw-r--r--.  1 wizard wizard  8617 Dec 14 