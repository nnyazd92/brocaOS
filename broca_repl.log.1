ept Exception as e:\\n    memory_summary['memories_count'] = None\\n\\nvec_summary = {}\\nvec_summary['vec_index_exists'] = vec_idx.exists()\\nvec_summary['vec_index_size'] = vec_idx.stat().st_size if vec_idx.exists() else None\\n\\n# list artifacts imported\\nartifacts_list = []\\nif artifacts_dir.exists():\\n    for p in sorted(artifacts_dir.rglob('*')):\\n        if p.is_file():\\n            artifacts_list.append({'path': str(p.relative_to(repo_root)), 'size': p.stat().st_size})\\n\\n# find current git commit\\ntry:\\n    commit = subprocess.check_output(['git','rev-parse','--verify','HEAD']).decode().strip()\\nexcept Exception:\\n    commit = None\\n\\n# run self-consistency check (non-mutative)\\nconsistency = {'ok': True, 'note': 'not-run'}\\ntry:\\n    from broca.self_model.consistency import ConsistencyChecker\\n    from broca.self_model.model import SelfModel\\n    checker = ConsistencyChecker()\\n    sm = None\\n    try:\\n        if hasattr(SelfModel, 'load'):\\n            sm = SelfModel.load()\\n    except Exception:\\n        sm = None\\n    example_resp = 'Shutdown consistency check (no mutation)'\\n    if sm is None:\\n        consistency = {'ok': True, 'note': 'SelfModel loader not available; skipped detailed check'}\\n    else:\\n        res = checker.validate(response=example_resp, self_model=sm, conversation_context=None)\\n        consistency = {'ok': res.is_consistent, 'violations': res.violations, 'severity': res.severity}\\nexcept Exception as e:\\n    consistency = {'ok': True, 'note': f'consistency-check-unavailable: {e}'}\\n\\n# Build identity JSON\\nidentity_dir = repo_root / 'docs' / 'identity'\\nidentity_dir.mkdir(parents=True, exist_ok=True)\\nidentity_path = identity_dir / 'IDENTITY.v0.1.json'\\nsign_path = identity_dir / 'IDENTITY.v0.1.signature.json'\\n\\nidentity = {}\\nidentity['schema_version'] = 'v0.1'\\nidentity['identity_id'] = None\\nidentity['name'] = 'BrocaOS-identity'\\nidentity['version'] = '0.1.1'\\nidentity['created_at'] = datetime.now(timezone.utc).isoformat()\\nidentity['last_updated_at'] = datetime.now(timezone.utc).isoformat()\\nidentity['created_by'] = 'wizard'\\nidentity['description'] = 'Shutdown sync identity'\\nidentity['pointers'] = {\\n    'memory_db': str(mem_db) if mem_db.exists() else None,\\n    'vector_index': str(vec_idx) if vec_idx.exists() else None,\\n    'self_model_db': str(repo_root / 'self_model.db') if (repo_root / 'self_model.db').exists() else None,\\n    'artifacts_root': str(artifacts_dir) if artifacts_dir.exists() else None,\\n    'memory_namespace_index': str(repo_root / 'memory_namespaces_index.md') if (repo_root / 'memory_namespaces_index.md').exists() else None,\\n    'rehydration_summary': str(repo_root / 'docs' / 'protocols' / 'REHYDRATION_SUMMARY.v0.2.md')\\n}\\nidentity['memory_namespace_index_summary'] = {'namespace_counts': {'broca/': memory_summary.get('memories_count')}, 'summary_hash': None}\\nidentity['self_model_summary_pointer'] = str(self_models_dir / 'self-20251219T222315Z.json') if (self_models_dir / 'self-20251219T222315Z.json').exists() else None\\nidentity['capabilities_pointer'] = str(repo_root / 'docs' / 'capabilities' / 'CAPABILITIES.v0.1.md') if (repo_root / 'docs' / 'capabilities').exists() else None\\nidentity['token_provenance'] = [{'type':'env','location':'BROCA_TOKEN_SECRET'}]\\nidentity['signed_by'] = None\\nidentity['signature_meta'] = None\\nidentity['audit'] = [{'ts': datetime.now(timezone.utc).isoformat(), 'action':'shutdown_sync', 'actor':'assistant', 'notes':'Shutdown sync executed', 'git_commit': commit}]\\n\\n# canonicalize and sign with env secret\\ncanonical = json.dumps(identity, separators=(',', ':'), sort_keys=True).encode('utf-8')\\nsig = hmac.new(env_secret.encode(), canonical, digestmod=hashlib.sha256).digest()\\nsig_b64 = base64.urlsafe_b64encode(sig).decode().rstrip('=')\\nidentity['signed_by'] = {'method':'hmac-sha256','signer_id':'env.BROCA_TOKEN_SECRET','created_at': datetime.now(timezone.utc).isoformat()}\\nidentity['signature_meta'] = {'algorithm':'HMAC-SHA256','signature_b64url': sig_b64, 'canonicalization': \\\"json.dumps(..., separators=(',',':'), sort_keys=True)\\\"}\\n\\n# Backup existing files\\nbackups = []\\nprotocols_dir = repo_root / 'docs' / 'protocols'\\nprotocols_dir.mkdir(parents=True, exist_ok=True)\\nmd_target = protocols_dir / 'REHYDRATION_SUMMARY.v0.2.md'\\njson_target = protocols_dir / 'REHYDRATION_SUMMARY.json'\\n\\nfor p in (md_target, json_target, identity_path, sign_path):\\n    if p.exists():\\n        bak = p.with_name(p.name + '.bak_' + now_ts)\\n        shutil.copy2(p, bak)\\n        backups.append(str(bak))\\n\\n# Write rehydration summary md + json\\nlines = []\\nlines.append('# REHYDRATION_SUMMARY.v0.2 - shutdown sync')\\nlines.append('')\\nlines.append(f'Run time (UTC): {datetime.now(timezone.utc).isoformat()}')\\nlines.append('')\\nlines.append('PERSISTENCE GATE:')\\nlines.append(f\\\"- mem_db_exists: {memory_summary.get('mem_db_exists')}\\\")\\nlines.append(f\\\"- memories_count: {memory_summary.get('memories_count')}\\\")\\nlines.append(f\\\"- vec_index_exists: {vec_summary.get('vec_index_exists')}\\\")\\nlines.append('')\\nlines.append('ARTIFACTS:')\\nfor a in artifacts_list[:200]:\\n    lines.append(f\\\"- {a['path']} (size={a['size']})\\\")\\nlines.append('')\\nlines.append('IDENTITY:')\\nlines.append(f\\\"- identity_path: {identity_path}\\\")\\nlines.append(f\\\"- signed_by: env.BROCA_TOKEN_SECRET\\\")\\nlines.append('')\\nlines.append('AUDIT:')\\nlines.append(f\\\"- git_commit: {commit}\\\")\\n\\nmd_body = '\\\\n'.join(lines)\\n# atomic write\\ntmp = md_target.with_suffix('.tmp')\\ntmp.write_text(md_body, encoding='utf-8')\\nos.replace(str(tmp), str(md_target))\\n\\njson_obj = {'generated_at': datetime.now(timezone.utc).isoformat(), 'memory': memory_summary, 'vector': vec_summary, 'artifacts_count': len(artifacts_list), 'git_commit': commit}\\ntmpj = json_target.with_suffix('.tmp')\\ntmpj.write_text(json.dumps(json_obj