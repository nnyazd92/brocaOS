()\nident_no_sig = {k:v for k,v in ident.items() if k!='signature_meta'}\nsig_bytes = hmac.new(secret.encode(), canon(ident_no_sig), hashlib.sha256).digest()\nsig_b64 = enc(sig_bytes)\n# Update identity signature_meta (preserve other fields)\nident['signature_meta'] = {\n    'algorithm': 'HMAC-SHA256',\n    'signature_b64url': sig_b64,\n    'canonicalization': \"json.dumps(..., separators=(',',':'), sort_keys=True)\"\n}\n# Update signed_by timestamp if present\nif isinstance(ident.get('signed_by'), dict):\n    ident['signed_by']['created_at'] = now_iso\nident_path.write_text(json.dumps(ident, indent=2))\n# Update sidecar\nsidecar = {'signature_b64url': sig_b64, 'algorithm': 'HMAC-SHA256', 'signed_at': time.strftime('%Y-%m-%dT%H:%M:%S.%fZ', time.gmtime())}\nsidecar_path.write_text(json.dumps(sidecar, indent=2))\n\nprint('TOKEN_WRITTEN', claims['exp'])\nprint('IDENTITY_RESIGNED', sig_b64)\nPY", "timeout": 120}}
