 v: v == 'broca-os',\n    'iss': lambda v: v in ('broca-token-v1','broca-os'),\n}.items():\n    if claim in payload and not check(payload[claim]):\n        errs.append(f'bad_{claim}')\n\nif 'exp' in payload and now >= int(payload['exp']):\n    errs.append('token_expired')\nif 'nbf' in payload and now < int(payload['nbf']):\n    errs.append('token_not_yet_valid')\n\nok = (valid_sig is True) and (not errs)\nprint(json.dumps({\n    'ok': ok,\n    'valid_sig': valid_sig,\n    'errs': errs,\n    'header': header,\n    'claims': payload,\n    'now': now,\n    'secret_present': bool(secret),\n}))\nPY"}}
