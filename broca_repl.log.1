{"level": "INFO", "logger": "broca.tools.registry", "message": "Tool call received: terminal", "taskName": null, "event": "tool_call_received", "tool_name": "terminal", "tool_call_id": "call_upDUZRVdL2wY9kiuHmUqE7SL", "arguments": {"command": "python - << 'PY'\nimport json, os, time, hmac, hashlib, base64, shutil\nfrom pathlib import Path\n\nroot = Path('.').resolve()\nnow_iso = time.strftime('%Y-%m-%dT%H:%M:%S%z')\nstamp = time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())\n\n# 1) Ensure docs/artifacts exists\nartifacts_dir = root / 'docs' / 'artifacts'\nartifacts_dir.mkdir(parents=True, exist_ok=True)\n\n# 2) Load identity and update pointer\nident_path = root / 'docs' / 'identity' / 'IDENTITY.v0.1.json'\nsidecar_path = root / 'docs' / 'identity' / 'IDENTITY.v0.1.signature.json'\nident = json.loads(ident_path.read_text())\n\n# backup\nshutil.copy2(ident_path, ident_path.with_suffix(ident_path.suffix+f'.bak_{stamp}'))\nif sidecar_path.exists():\n    shutil.copy2(sidecar_path, sidecar_path.with_suffix(sidecar_path.suffix+f'.bak_{stamp}'))\n\n# Update pointer to absolute path\nident.setdefault('pointers', {})['artifacts_root'] = str(artifacts_dir)\n\n# 3) Re-sign identity using env secret\nsecret = None\nfor line in (root/'.env').read_text().splitlines():\n    if line.strip().startswith('BROCA_TOKEN_SECRET='):\n        secret = line.split('=',1)[1].strip(); break\nassert secret, 'BROCA_TOKEN_SECRET missing'\n\ncanon = lambda obj: json.dumps(obj, separators=(',',':'), sort_keys=True).encode()\nenc = lambda b: base64.urlsafe_b64encode(b).decode().rstrip('=')\nident_no_sig = {k:v for k,v in ident.items() if k!='signature_meta'}\nsig_b64 = enc(hmac.new(secret.encode(), canon(ident_no_sig), hashlib.sha256).digest())\nident['signature_meta'] = {\n  'algorithm': 'HMAC-SHA256',\n  'signature_b64url': sig_b64,\n  'canonicalization': \"json.dumps(..., separators=(',',':'), sort_keys=True)\"\n}\n# Update signed_by timestamp if present\nif isinstance(ident.get('signed_by'), dict):\n    ident['signed_by']['created_at'] = now_iso\n\nident_path.write_text(json.dumps(ident, indent=2))\nsidecar = {'signature_b64url': sig_b64, 'algorithm': 'HMAC-SHA256', 'signed_at': time.strftime('%Y-%m-%dT%H:%M:%S.%fZ', time.gmtime())}\nsidecar_path.write_text(json.dumps(sidecar, indent=2))\n\n# 4) Update rehydration summary pointers + md\nproto_dir = root / 'docs' / 'protocols'\nsum_json = proto_dir/'REHYDRATION_SUMMARY.json'\nsum_md = proto_dir/'REHYDRATION_SUMMARY.v0.2.md'\ns = json.loads(sum_json.read_text())\ns['boot_ts'] = now_iso\nptr = s.get('pointers_validated', {})\nptr['artifacts_root'] = {\n  'path': str(artifacts_dir),\n  'exists': True,\n  'is_dir': True,\n  'size': None\n}\ns['pointers_validated'] = ptr\n\n# Render md\nlines = []\nlines.append('# Rehydration Summary v0.2')\nlines.append(f\"- boot_ts: {s['boot_ts']}\")\nlines.append(f\"- operator: {s['operator']}\")\nlines.append(f\"- persistence_enabled: {s['persistence_enabled']} ({s['gating_posture']})\")\nlines.append('## Token')\nlines.append(f\"- source: {s['token_provenance']['source']} (secret: {s['token_provenance']['env_secret']})\")\nlines.append(f\"- verified: {s['token_provenance']['jwt_valid']}\")\nlines.append(f\"- jti: {s['token_provenance']['jwt_claims'].get('jti')} exp: {s['token_provenance']['jwt_claims'].get('exp')} scopes: {s['token_provenance']['jwt_claims'].get('scopes')}\")\nlines.append('## Identity verification')\nlines.append(f\"- identity_path: {s['identity']['path']}\")\nlines.append(f\"- sidecar: {s['identity']['sidecar']}\")\nlines.append(f\"- verified: {s['identity']['verified']}\")\nfor k,v in s['pointers_validated'].items():\n    lines.append(f\"- {k}: exists={v['exists']} size={v['size']} path={v['path']}\")\nlines.append('## Steps')\nfor k,v in s['steps_status'].items():\n    lines.append(f\"- {k}: {v}\")\n\nsum_json.write_text(json.dumps(s, indent=2))\nsum_md.write_text('\\n'.join(lines)+'\\n')\n\n# 5) Append log\nwith open(root/'boot.log','a') as f:\n    f.write(f\"[{now_iso}] Updated artifacts_root to {artifacts_dir}; re-signed identity.\\n\")\n\nprint('UPDATED', str(artifacts_dir))\nPY", "timeout": 120}, "raw_tool_call": null}
