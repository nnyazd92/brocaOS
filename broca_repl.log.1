ar_path, sidecar_path.with_suffix(sidecar_path.suffix+f'.bak_{stamp}'))\n\ncanon = lambda obj: json.dumps(obj, separators=(',',':'), sort_keys=True).encode()\nident_no_sig = {k:v for k,v in ident.items() if k!='signature_meta'}\nsig_bytes = hmac.new(secret.encode(), canon(ident_no_sig), hashlib.sha256).digest()\nsig_b64 = enc(sig_bytes)\n# Update identity signature_meta (preserve other fields)\nident['signature_meta'] = {\n    'algorithm': 'HMAC-SHA256',\n    'signature_b64url': sig_b64,\n    'canonicalization': \"json.dumps(..., separators=(',',':'), sort_keys=True)\"\n}\n# Update signed_by timestamp if present\nif isinstance(ident.get('signed_by'), dict):\n    ident['signed_by']['created_at'] = now_iso\nident_path.write_text(json.dumps(ident, indent=2))\n# Update sidecar\nsidecar = {'signature_b64url': sig_b64, 'algorithm': 'HMAC-SHA256', 'signed_at': time.strftime('%Y-%m-%dT%H:%M:%S.%fZ', time.gmtime())}\nsidecar_path.write_text(json.dumps(sidecar, indent=2))\n\nprint('TOKEN_WRITTEN', claims['exp'])\nprint('IDENTITY_RESIGNED', sig_b64)\nPY"}, "formatted_result": "Command: python - << 'PY'\nimport os, json, time, hmac, hashlib, base64, uuid, shutil\nfrom pathlib import Path\n\nnow = int(time.time())\nnow_iso = time.strftime('%Y-%m-%dT%H:%M:%S%z')\nroot = Path('.')\n# 1) Load secret\nsecret = None\nfor line in Path('.env').read_text().splitlines():\n    line=line.strip()\n    if line.startswith('BROCA_TOKEN_SECRET='):\n        secret = line.split('=',1)[1].strip()\n        break\nassert secret, 'BROCA_TOKEN_SECRET not found in .env'\n\n# 2) Generate JWT (2h expiry)\nheader = {\"alg\":\"HS256\",\"typ\":\"JWT\"}\nclaims = {\n    \"aud\":\"broca-os\",\n    \"iss\":\"broca-token-v1\",\n    \"sub\":\"nick.yazdani\",\n    \"name\":\"Nick Yazdani\",\n    \"scopes\":[\"filesystem:write\",\"project:write\",\"memory:write\"],\n    \"iat\": now,\n    \"exp\": now + 2*60*60,\n    \"jti\": uuid.uuid4().hex\n}\nenc = lambda b: base64.urlsafe_b64encode(b).decode().rstrip('=')\nms