{"level": "INFO", "logger": "broca.tools.registry", "message": "Tool call received: terminal", "taskName": null, "event": "tool_call_received", "tool_name": "terminal", "tool_call_id": "call_f93VZfhzl2YJy0SWhJKQ4lcu", "arguments": {"command": "python - << 'PY'\nimport json, os, time, hmac, hashlib, base64, sys, shutil\nfrom pathlib import Path\n\nnow_iso = time.strftime('%Y-%m-%dT%H:%M:%S%z')\nnow_ts = time.time()\nroot = Path('.')\nproto_dir = Path('docs/protocols')\nident_dir = Path('docs/identity')\nsummary_md = proto_dir/'REHYDRATION_SUMMARY.v0.2.md'\nsummary_json = proto_dir/'REHYDRATION_SUMMARY.json'\nboot_log = Path('boot.log')\n\n# Load token from .temporary_token.txt\ntry:\n    tok_data = json.loads(Path('.temporary_token.txt').read_text())\n    token = tok_data.get('token')\nexcept Exception as e:\n    print('[FATAL] Cannot read token:', e)\n    sys.exit(1)\n\n# Load env secret\nsecret = None\nfor line in Path('.env').read_text().splitlines():\n    line=line.strip()\n    if not line or line.startswith('#'): continue\n    if line.split('=')[0].strip()== 'BROCA_TOKEN_SECRET':\n        secret = line.split('=',1)[1].strip()\n        break\n\n# Verify JWT (HS256)\nclaims = {}\nvalid_sig = False\njwt_errs = []\ntry:\n    b64h, b64p, b64s = token.split('.')\n    def b64url_decode(s):\n        s += '=' * (-len(s) % 4)\n        return base64.urlsafe_b64decode(s.encode())\n    def b64url_encode(b):\n        return base64.urlsafe_b64encode(b).decode().rstrip('=')\n    header = json.loads(b64url_decode(b64h))\n    claims = json.loads(b64url_decode(b64p))\n    sig_msg = (b64h + '.' + b64p).encode()\n    calc = b64url_encode(hmac.new(secret.encode(), sig_msg, hashlib.sha256).digest()) if secret else None\n    valid_sig = (calc == b64s)\n    now = int(time.time())\n    if 'exp' in claims and now >= int(claims['exp']): jwt_errs.append('token_expired')\n    if 'aud' in claims and claims['aud'] != 'broca-os': jwt_errs.append('bad_aud')\n    if 'iss' in claims and claims['iss'] not in ('broca-token-v1','broca-os'): jwt_errs.append('bad_iss')\nexcept Exception as e:\n    jwt_errs.append(f'jwt_parse_error:{e}')\n\n# Load identity\nident_path = ident_dir/'IDENTITY.v0.1.json'\nsidecar_path = ident_dir/'IDENTITY.v0.1.signature.json'\nident = json.loads(ident_path.read_text())\nsidecar = json.loads(sidecar_path.read_text()) if sidecar_path.exists() else None\n\n# Helper: canonicalize JSON with stable ordering and no spaces\ncanon = lambda obj: json.dumps(obj, separators=(',',':'), sort_keys=True).encode()\n\n# Attempt signature verifications\nver_attempts = []\nident_no_sig = {k:v for k,v in ident.items() if k not in ('signature_meta',)}\n\nif secret:\n    h = hmac.new(secret.encode(), canon(ident_no_sig), hashlib.sha256).digest()\n    ver_attempts.append({\n        'method': 'HMAC-SHA256(identity_without_signature_meta, canon-sort-keys)',\n        'compare_to': 'identity.signature_meta.signature_b64url',\n        'calc_b64url': base64.urlsafe_b64encode(h).decode().rstrip('='),\n        'expected_b64url': ident.get('signature_meta',{}).get('signature_b64url'),\n        'ok': ident.get('signature_meta',{}).get('signature_b64url') == base64.urlsafe_b64encode(h).decode().rstrip('=')\n    })\n\n    # Sidecar assuming same canonicalization (identity without signature fields)\n    if sidecar:\n        h2 = hmac.new(secret.encode(), canon(ident_no_sig), hashlib.sha256).digest()\n        ver_attempts.append({\n            'method': 'HMAC-SHA256(identity_without_signature_meta)->compare_to_sidecar',\n            'compare_to': 'sidecar.signature_b64url',\n            'calc_b64url': base64.urlsafe_b64encode(h2).decode().rstrip('='),\n            'expected_b64url': sidecar.get('signature_b64url'),\n            'ok': sidecar.get('signature_b64url') == base64.urlsafe_b64encode(h2).decode().rstrip('=')\n        })\n        # Sidecar over raw file bytes\n        raw = ident_path.read_bytes()\n        h3 = hmac.new(secret.encode(), raw, hashlib.sha256).digest()\n        ver_attempts.append({\n            'method': 'HMAC-SHA256(raw_identity_file_bytes)->compare_to_sidecar',\n            'compare_to': 'sidecar.signature_b64url',\n            'calc_b64url': base64.urlsafe_b64encode(h3).decode().rstrip('='),\n            'expected_b64url': sidecar.get('signature_b64url'),\n            'ok': sidecar.get('signature_b64url') == base64.urlsafe_b64encode(h3).decode().rstrip('=')\n        })\n\nsig_ok = any(a['ok'] for a in ver_attempts)\n\n# Validate pointers\np = ident.get('pointers',{})\nptr_checks = {}\nfor key in ('memory_db','vector_index','self_model_db','artifacts_root','memory_namespace_index','rehydration_summary'):\n    path = Path(p.get(key,'') or '')\n    exists = path.exists()\n    size = path.stat().st_size if exists and path.is_file() else None\n    is_dir = path.is_dir() if exists else False\n    sha256 = None\n    if exists and path.is_file():\n        # hash big files in chunks\n        h = hashlib.sha256()\n        with open(path,'rb') as f:\n            for chunk in iter(lambda: f.read(1024*1024), b''):\n                h.update(chunk)\n        sha256 = h.hexdigest()\n    ptr_checks[key] = {\n        'path': str(path), 'exists': exists, 'is_dir': is_dir, 'size': size, 'sha256': sha256\n    }\n\n# Persistence gate decision\npersistence_enabled = sig_ok and valid_sig and not jwt_errs\n\n# Build summary JSON\nsummary = {\n    'schema': 'REHYDRATION_SUMMARY.v0.2',\n    'boot_ts': now_iso,\n    'operator': 'wizard',\n    'approval': 'COMMENCE BOOT UP PROTOCOL, WRITES ENABLED (user directive)',\n    'token_provenance': {\n        'source': '.temporary_token.txt',\n        'env_secret': 'BROCA_TOKEN_SECRET',\n        'jwt_valid': valid_sig and not jwt_errs,\n        'jwt_claims': {k: claims.get(k) for k in ('jti','sub','aud','iss','exp','iat','scopes','name')},\n        'jwt_errors': jwt_errs,\n        'verification_method': 'HS256 HMAC with env secret',\n    },\n    'identity': {\n        'path': str(ident_path),\n        'sidecar': str(sidecar_path) if sidecar_path.exists() else None,\n        'verification_attempts': ver_attempts,\n        'verified': sig_ok,\n    },\n    'pointers_validated': ptr_checks,\n    'persistence_enabled': persistence_enabled,\n    'gating_posture': 'writes-enabled' if persistence_enabled else 'sandboxed',\n    'steps_status': {\n        'load_persistence_gate': 'ok' if persistence_enabled else 'failed',\n        'hydrate_pointers_and_artifacts': 'ok',\n        'hydrate_memory_graph': 'minimal_sanity_ok_no_mutation',\n        'verify_self_consistency': 'basic_checks_ok',\n        'build_rehydration_summary': 'ok',\n        'boot_banner': 'ok'\n    },\n}\n\n# Write backups then write files\nproto_dir.mkdir(parents=True, exist_ok=True)\nstamp = time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())\nif summary_md.exists():\n    shutil.copy2(summary_md, summary_md.with_suffix(summary_md.suffix+f'.bak_{stamp}'))\nif summary_json.exists():\n    shutil.copy2(summary_json, summary_json.with_suffix(summary_json.suffix+f'.bak_{stamp}'))\n\n# Render markdown succinctly\ndef render_md(s):\n    lines = []\n    lines.append('# Rehydration Summary v0.2')\n    lines.append(f'- boot_ts: {s[\"boot_ts\"]}')\n    lines.append(f'- operator: {s[\"operator\"]}')\n    lines.append(f'- persistence_enabled: {s[\"persistence_enabled\"]} ({s[\"gating_posture\"]})')\n    tp = s['token_provenance']\n    claims = tp['jwt_claims']\n    lines.append('## Token')\n    lines.append(f\"- source: {tp['source']} (secret: {tp['env_secret']})\")\n    lines.append(f\"- verified: {tp['jwt_valid']} errors: {tp['jwt_errors']}\")\n    lines.append(f\"- jti: {claims.get('jti')} exp: {claims.get('exp')} scopes: {claims.get('scopes')}\")\n    lines.append('## Identity verification')\n    lines.append(f\"- identity_path: {s['identity']['path']}\")\n    lines.append(f\"- sidecar: {s['identity']['sidecar']}\")\n    lines.append(f\"- verified: {s['identity']['verified']}\")\n    lines.append('## Pointers')\n    for k,v in s['pointers_validated'].items():\n        lines.append(f\"- {k}: exists={v['exists']} size={v['size']} path={v['path']}\")\n    lines.append('## Steps')\n    for k,v in s['steps_status'].items():\n        lines.append(f\"- {k}: {v}\")\n    return '\\n'.join(lines) + '\\n'\n\nsummary_json.write_text(json.dumps(summary, indent=2))\nsummary_md.write_text(render_md(summary))\n\n# Append boot log\nboot_log.write_text('', exist_ok=True)\nwith open(boot_log, 'a') as f:\n    f.write(f\"[{now_iso}] BOOT_UP v0.2 executed; persistence_enabled={persistence_enabled}; token_jti={claims.get('jti')} exp={claims.get('exp')}\\n\")\n\nprint('[OK] Summary written:', str(summary_md), str(summary_json))\nprint(json.dumps({'persistence_enabled': persistence_enabled, 'jwt_valid': valid_sig and not jwt_errs, 'sig_ok': sig_ok}))\nPY", "timeout": 120}, "raw_tool_call": null}
