{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Procedural Emergence Result",
  "type": "object",
  "required": ["task_id", "success", "start_time", "end_time", "duration"],
  "properties": {
    "task_id": {"type": "string"},
    "success": {"type": "boolean"},
    "final_output": {"type": ["string", "null"]},
    "error": {"type": ["string", "null"]},
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool": {"type": "string"},
          "parameters": {"type": "object"},
          "result": {"type": "object"},
          "timestamp": {"type": "string", "format": "date-time"}
        }
      }
    },
    "procedures_applied": {
      "type": "array",
      "items": {"type": "object", "properties": {"procedure_name": {"type": "string"}, "confidence": {"type": "number"}}}
    },
    "rl_signals": {"type": "object"},
    "dissonance_before": {"type": ["number", "null"]},
    "dissonance_after": {"type": ["number", "null"]},
    "start_time": {"type": "string", "format": "date-time"},
    "end_time": {"type": "string", "format": "date-time"},
    "duration": {"type": "number"}
  }
}
