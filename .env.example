# BrocaOS minimal runtime config (REPL + Web API)
#
# Usage:
#   cp .env.example .env
#   # edit .env with your keys
#   python -m broca.main_repl
#   python -m broca.web_api --host 127.0.0.1 --port 8000
#
# IMPORTANT: You must configure at least ONE chat provider API key.

# =========================
# Chat LLM (REQUIRED)
# =========================
# Choose one: deepseek | openai | gemini
BROCA_LLM_PROVIDER=gemini

# --- Gemini (recommended for web/repl) ---
GEMINI_API_KEY=your-gemini-api-key
# Optional overrides:
# GEMINI_MODEL=gemini-3.0-flash-001
# BROCA_GEMINI_USE_SDK=true
# BROCA_GEMINI_THINKING_LEVEL=low

# --- OpenAI (alternative) ---
# OPENAI_API_KEY=your-openai-api-key
# Optional override:
# BROCA_LLM_MODEL=gpt-5.2

# --- DeepSeek (alternative) ---
# DEEPSEEK_API_KEY=your-deepseek-api-key
# Optional override:
# DEEPSEEK_MODEL=deepseek-chat

# =========================
# Embeddings (OPTIONAL, enables MemoryManager)
# =========================
# If unset, Broca will disable the vector memory subsystem (memory tools still exist but may be limited).
# Provide either EMBEDDING_API_KEY or OPENAI_API_KEY (embedding config uses OPENAI-compatible /v1/embeddings).
EMBEDDING_API_KEY=your-embedding-api-key
# Optional overrides:
# BROCA_EMBEDDING_API_BASE=https://api.openai.com/v1
# BROCA_EMBEDDING_MODEL=text-embedding-3-small
# BROCA_EMBEDDING_DIMENSION=1536

# =========================
# Web Search (OPTIONAL)
# =========================
# If unset, WEB_SEARCH will degrade gracefully (no Tavily results).
TAVILY_API_KEY=your-tavily-api-key

# =========================
# Tooling / Macro toolset (RECOMMENDED)
# =========================
# Use explicit macros instead of legacy universal actuators.
BROCA_TOOLSET=primitive

# Keep legacy terminal tool disabled by default (macro EXECUTE is governed separately).
BROCA_ENABLE_TERMINAL=false

# Enforce a strict whitelist for EXECUTE base commands.
# Only the first executable token must match (args can vary).
BROCA_EXECUTE_WHITELIST=python,sage,find

# Tool policy mode: normal | read_only
BROCA_TOOLS_MODE=normal
